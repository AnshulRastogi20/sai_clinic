{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.saiclinic.health" }],
      "destination": "https://saiclinic.health/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sai-clinic-indol.vercel.app" }],
      "destination": "https://saiclinic.health/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
